:: ======================================================================
:: SMART_MEDIA_LOADER.BAT
:: ======================================================================
::
:: Что делает данный BAT-файл:
::
:: Это "умный" загрузчик медиа, который умеет скачивать:
:: - MP4 видео
:: - MP3 аудио
::
:: по прямой ссылке на видео-страницу (например YouTube, Kinescope и др.,
:: если сайт поддерживается yt-dlp).
::
:: ----------------------------------------------------------------------
:: Основные возможности:
::
:: 1. Проверяет наличие yt-dlp.exe рядом со скриптом
::
:: 2. Проверяет наличие ffmpeg.exe и ffprobe.exe по заданному пути
::
:: 3. Принимает ссылку:
::    - либо из аргумента командной строки
::    - либо спрашивает у пользователя вручную
::
:: 4. Для YouTube автоматически добавляет:
::    - --js-runtimes node
::    - --cookies cookies.txt, если файл cookies.txt лежит рядом
::
:: 5. Даёт выбрать формат:
::    - mp3
::    - mp4
::
:: 6. Для MP4:
::    - получает список доступных форматов через yt-dlp -F
::    - пытается автоматически найти ID потоков:
::      1080p / 720p / 480p / 360p
::    - пытается найти audio-only поток
::    - строит меню качества
::    - позволяет выбрать:
::      * лучшее доступное
::      * конкретное качество
::      * ручной ввод video id / audio id
::
:: 7. Для MP4 скачивает видео и аудио, затем объединяет в mp4
::
:: 8. Для MP3 скачивает лучший доступный аудиопоток и конвертирует его в mp3
::
:: 9. Проверяет:
::    - код завершения yt-dlp
::    - был ли реально создан выходной файл
::
:: 10. Сообщает итоговый путь готового файла
::
:: ----------------------------------------------------------------------
:: Особенности:
::
:: - Скрипт НЕ использует cookies из Chrome принудительно
:: - cookies.txt подключается только если файл реально существует
:: - Для YouTube желательно наличие Node.js в PATH
:: - Для работы нужен yt-dlp.exe рядом со скриптом
::
:: ----------------------------------------------------------------------
:: Пример запуска:
::
:: smart_media_loader.bat https://www.youtube.com/watch?v=...
::
:: или просто:
::
:: smart_media_loader.bat
::
:: и ссылка будет запрошена вручную
:: ======================================================================

@echo off

:: ----------------------------------------------------------------------
:: Отключаем вывод исполняемых команд в консоль
:: ----------------------------------------------------------------------

chcp 65001 >nul

:: ----------------------------------------------------------------------
:: Включаем UTF-8 кодировку консоли
:: Нужно для корректного отображения русского текста и символов
:: ----------------------------------------------------------------------

setlocal EnableDelayedExpansion

:: ----------------------------------------------------------------------
:: Создаём локальную область переменных
:: и включаем delayed expansion для использования !VAR!
:: внутри блоков if / for
:: ----------------------------------------------------------------------


:: ==========================================================
:: smart_media_loader.bat
:: Умный загрузчик MP4 / MP3
:: Без принудительного Chrome cookies
:: ==========================================================

:: ----------------------------------------------------------------------
:: Папка, где лежит сам BAT-файл
:: %~dp0 = drive + path текущего скрипта
:: ----------------------------------------------------------------------
set "SCRIPT_DIR=%~dp0"

:: ----------------------------------------------------------------------
:: Ожидаем, что yt-dlp.exe лежит рядом со скриптом
:: ----------------------------------------------------------------------
set "YTDLP=%SCRIPT_DIR%yt-dlp.exe"

:: ----------------------------------------------------------------------
:: Путь к пользовательской папке с ffmpeg / ffprobe
:: ----------------------------------------------------------------------
set "CUSTOM_FFMPEG=D:\DEV\lib\ffmpeg-8.0-essentials_build\bin"

:: ----------------------------------------------------------------------
:: Если рядом со скриптом есть cookies.txt,
:: он будет использован для некоторых сайтов (например YouTube)
:: ----------------------------------------------------------------------
set "COOKIES_TXT=%SCRIPT_DIR%cookies.txt"

:: ------------------------------------------------
:: Проверка yt-dlp
:: ------------------------------------------------
:: Проверяем, существует ли yt-dlp.exe рядом со скриптом
if not exist "%YTDLP%" (
    echo ❌ Не найден yt-dlp.exe рядом со скриптом:
    echo %YTDLP%
    pause
    exit /b 1
)

:: ------------------------------------------------
:: Проверка ffmpeg
:: ------------------------------------------------
:: Проверяем, что в указанной папке существуют и ffmpeg.exe, и ffprobe.exe
if exist "%CUSTOM_FFMPEG%\ffmpeg.exe" if exist "%CUSTOM_FFMPEG%\ffprobe.exe" (
    :: Если оба файла найдены — формируем аргумент для yt-dlp
    set "FFMPEG_ARG=--ffmpeg-location ""%CUSTOM_FFMPEG%"""
) else (
    :: Если хотя бы одного нет — выходим с ошибкой
    echo ❌ ffmpeg.exe / ffprobe.exe не найдены:
    echo %CUSTOM_FFMPEG%
    pause
    exit /b 1
)

:: ------------------------------------------------
:: Шапка
:: ------------------------------------------------
:: Очищаем экран
cls

:: Выводим заголовок интерфейса
echo ╔══════════════════════════════════════════════╗
echo ║           🎬 SMART MEDIA LOADER             ║
echo ╚══════════════════════════════════════════════╝
echo.

:: ------------------------------------------------
:: Ссылка
:: ------------------------------------------------
:: Если ссылка не была передана первым аргументом,
:: спрашиваем её у пользователя
if "%~1"=="" (
    set /p INPUT=🔗 Вставьте ссылку:
) else (
    :: Если аргумент был передан — используем его
    set "INPUT=%~1"
)

:: Если ссылка так и не получена — выходим
if "%INPUT%"=="" (
    echo ❌ Ссылка не указана.
    pause
    exit /b 1
)

:: Сохраняем ссылку в отдельную рабочую переменную
set "DOWNLOAD_URL=%INPUT%"

:: ------------------------------------------------
:: Доп параметры
:: ------------------------------------------------
:: Базовый набор параметров для yt-dlp
set "EXTRA_ARGS=--no-update"

:: ----------------------------------------------------------------------
:: Если ссылка похожа на YouTube:
:: - добавляем JS runtime через node
:: - подключаем cookies.txt, если он существует
:: ----------------------------------------------------------------------
echo %DOWNLOAD_URL% | findstr /i "youtube.com youtu.be" >nul
if %ERRORLEVEL%==0 (
    set "EXTRA_ARGS=--no-update --js-runtimes node"
    if exist "%COOKIES_TXT%" (
        set "EXTRA_ARGS=!EXTRA_ARGS! --cookies ""%COOKIES_TXT%"""
    )
)

:: ------------------------------------------------
:: Формат
:: ------------------------------------------------
echo.
set /p FORMAT=Введите формат (mp3/mp4):

:: Если выбран mp3 — переходим сразу к запросу имени файла
if /i "%FORMAT%"=="mp3" goto ASK_NAME

:: Если выбран mp4 — сначала строим меню качества
if /i "%FORMAT%"=="mp4" goto BUILD_MENU

:: Если введено что-то иное — ошибка
echo ❌ Неверный формат.
pause
exit /b 1

:: ==========================================================
:: MP4: строим меню качества
:: ==========================================================
:BUILD_MENU

echo.
echo 🔍 Анализ доступных форматов...
echo.

:: ----------------------------------------------------------------------
:: Временный файл для сохранения вывода yt-dlp -F
:: ----------------------------------------------------------------------
set "TMPFILE=%TEMP%\yt_formats_%RANDOM%.txt"

:: ----------------------------------------------------------------------
:: Получаем список доступных форматов
:: -F = показать все форматы
:: ----------------------------------------------------------------------
"%YTDLP%" %EXTRA_ARGS% %FFMPEG_ARG% -F "%DOWNLOAD_URL%" > "%TMPFILE%"
if errorlevel 1 (
    echo ❌ Не удалось получить список форматов.
    echo.
    echo Возможные причины:
    echo  - YouTube снова требует cookies / авторизацию
    echo  - node не установлен или не в PATH
    echo  - ролик ограничен по стране / возрасту / аккаунту
    if exist "%TMPFILE%" del /q "%TMPFILE%"
    pause
    exit /b 1
)

:: ----------------------------------------------------------------------
:: Пытаемся найти audio-only поток в формате m4a
:: Берём первый найденный ID
:: ----------------------------------------------------------------------
set "AUDIO_ID="
for /f "tokens=1,* delims= " %%a in ('findstr /i /c:"audio only" "%TMPFILE%" ^| findstr /i "m4a"') do (
    if not defined AUDIO_ID set "AUDIO_ID=%%a"
)

:: Если m4a audio-only не найден — берём любой audio-only
if not defined AUDIO_ID (
    for /f "tokens=1,* delims= " %%a in ('findstr /i /c:"audio only" "%TMPFILE%"') do (
        if not defined AUDIO_ID set "AUDIO_ID=%%a"
    )
)

:: ----------------------------------------------------------------------
:: Готовим переменные для видеоформатов
:: ----------------------------------------------------------------------
set "ID1080="
set "ID720="
set "ID480="
set "ID360="

:: ----------------------------------------------------------------------
:: Ищем mp4-видео по популярным разрешениям
:: Берём первый найденный ID для каждого качества
:: ----------------------------------------------------------------------
for /f "tokens=1,* delims= " %%a in ('findstr /i "1080 mp4" "%TMPFILE%"') do (
    if not defined ID1080 set "ID1080=%%a"
)
for /f "tokens=1,* delims= " %%a in ('findstr /i "720 mp4" "%TMPFILE%"') do (
    if not defined ID720 set "ID720=%%a"
)
for /f "tokens=1,* delims= " %%a in ('findstr /i "480 mp4" "%TMPFILE%"') do (
    if not defined ID480 set "ID480=%%a"
)
for /f "tokens=1,* delims= " %%a in ('findstr /i "360 mp4" "%TMPFILE%"') do (
    if not defined ID360 set "ID360=%%a"
)

:: ----------------------------------------------------------------------
:: Если mp4-варианты не найдены — пробуем искать просто по числу качества
:: ----------------------------------------------------------------------
if not defined ID1080 (
    for /f "tokens=1,* delims= " %%a in ('findstr /i "1080" "%TMPFILE%"') do (
        if not defined ID1080 set "ID1080=%%a"
    )
)
if not defined ID720 (
    for /f "tokens=1,* delims= " %%a in ('findstr /i "720" "%TMPFILE%"') do (
        if not defined ID720 set "ID720=%%a"
    )
)
if not defined ID480 (
    for /f "tokens=1,* delims= " %%a in ('findstr /i "480" "%TMPFILE%"') do (
        if not defined ID480 set "ID480=%%a"
    )
)
if not defined ID360 (
    for /f "tokens=1,* delims= " %%a in ('findstr /i "360" "%TMPFILE%"') do (
        if not defined ID360 set "ID360=%%a"
    )
)

:: ----------------------------------------------------------------------
:: Показываем меню качества
:: ----------------------------------------------------------------------
echo ╔══════════════════════════════════════════════╗
echo ║            ДОСТУПНЫЕ КАЧЕСТВА               ║
echo ╚══════════════════════════════════════════════╝
echo 1. Лучшее доступное
if defined ID1080 echo 2. 1080p   [video !ID1080! + audio !AUDIO_ID!]
if defined ID720  echo 3. 720p    [video !ID720! + audio !AUDIO_ID!]
if defined ID480  echo 4. 480p    [video !ID480! + audio !AUDIO_ID!]
if defined ID360  echo 5. 360p    [video !ID360! + audio !AUDIO_ID!]
echo 6. Ручной ввод ID
echo.

:: Просим выбрать пункт меню
set /p MENU=Выберите номер:

:: ----------------------------------------------------------------------
:: Обработка выбора качества
:: ----------------------------------------------------------------------

:: Лучшее доступное качество
if "%MENU%"=="1" (
    set "FORMAT_SELECTOR=bv*[ext=mp4]+ba[ext=m4a]/bv*+ba/b"
    set "QUALITY=BEST"
    goto ASK_NAME
)

:: 1080p
if "%MENU%"=="2" if defined ID1080 (
    set "FORMAT_SELECTOR=!ID1080!+!AUDIO_ID!"
    set "QUALITY=1080p"
    goto ASK_NAME
)

:: 720p
if "%MENU%"=="3" if defined ID720 (
    set "FORMAT_SELECTOR=!ID720!+!AUDIO_ID!"
    set "QUALITY=720p"
    goto ASK_NAME
)

:: 480p
if "%MENU%"=="4" if defined ID480 (
    set "FORMAT_SELECTOR=!ID480!+!AUDIO_ID!"
    set "QUALITY=480p"
    goto ASK_NAME
)

:: 360p
if "%MENU%"=="5" if defined ID360 (
    set "FORMAT_SELECTOR=!ID360!+!AUDIO_ID!"
    set "QUALITY=360p"
    goto ASK_NAME
)

:: Ручной ввод video id / audio id
if "%MENU%"=="6" (
    set /p VID=Введите video id:
    set /p AUD=Введите audio id:

    if "!VID!"=="" (
        echo ❌ video id пустой.
        del /q "%TMPFILE%" 2>nul
        pause
        exit /b 1
    )

    if "!AUD!"=="" (
        set "FORMAT_SELECTOR=!VID!"
    ) else (
        set "FORMAT_SELECTOR=!VID!+!AUD!"
    )

    set "QUALITY=MANUAL"
    goto ASK_NAME
)

:: Если введён неверный пункт меню
echo ❌ Неверный выбор.
del /q "%TMPFILE%" 2>nul
pause
exit /b 1

:: ==========================================================
:: Имя файла
:: ==========================================================
:ASK_NAME

echo.
set /p FILENAME=Введите имя файла (без расширения):

:: Если имя не введено — используем media
if "%FILENAME%"=="" set "FILENAME=media"

:: Создаём папки назначения, если их нет
if not exist "data\mp4" mkdir "data\mp4"
if not exist "data\mp3" mkdir "data\mp3"

:: ==========================================================
:: MP4
:: ==========================================================
if /i "%FORMAT%"=="mp4" (
    echo.
    echo ============================================
    echo 📥 Скачивание видео...
    echo Качество: %QUALITY%
    echo Selector: %FORMAT_SELECTOR%
    echo ============================================
    echo.

    :: ----------------------------------------------------------
    :: Скачиваем выбранный видео+аудио поток и объединяем в mp4
    :: ----------------------------------------------------------
    "%YTDLP%" %EXTRA_ARGS% %FFMPEG_ARG% ^
        -f "%FORMAT_SELECTOR%" ^
        --merge-output-format mp4 ^
        -o "data/mp4/%FILENAME%.mp4" ^
        "%DOWNLOAD_URL%"

    :: Сохраняем код завершения yt-dlp
    set "DLERR=%ERRORLEVEL%"

    :: Удаляем временный файл со списком форматов
    if exist "%TMPFILE%" del /q "%TMPFILE%" 2>nul

    :: Если yt-dlp завершился с ошибкой
    if not "%DLERR%"=="0" (
        echo ❌ Ошибка при скачивании MP4.
        pause
        exit /b 1
    )

    :: Если файл не создан — тоже считаем это ошибкой
    if not exist "data\mp4\%FILENAME%.mp4" (
        echo ❌ Файл MP4 не был создан.
        pause
        exit /b 1
    )

    :: Успех
    echo.
    echo ✅ Готово: data\mp4\%FILENAME%.mp4
    pause
    exit /b 0
)

:: ==========================================================
:: MP3
:: ==========================================================
if /i "%FORMAT%"=="mp3" (
    echo.
    echo 🎧 Извлекаем MP3...
    echo.

    :: ----------------------------------------------------------
    :: Скачиваем лучший доступный аудиопоток и конвертируем в mp3
    :: ----------------------------------------------------------
    "%YTDLP%" %EXTRA_ARGS% %FFMPEG_ARG% ^
        -f "ba/b" ^
        -x --audio-format mp3 ^
        -o "data/mp3/%FILENAME%.mp3" ^
        "%DOWNLOAD_URL%"

    :: Сохраняем код завершения yt-dlp
    set "DLERR=%ERRORLEVEL%"

    :: Если скачивание завершилось с ошибкой
    if not "%DLERR%"=="0" (
        echo ❌ Ошибка при скачивании MP3.
        pause
        exit /b 1
    )

    :: Если файл реально не был создан
    if not exist "data\mp3\%FILENAME%.mp3" (
        echo ❌ Файл MP3 не был создан.
        pause
        exit /b 1
    )

    :: Успех
    echo.
    echo ✅ Готово: data\mp3\%FILENAME%.mp3
    pause
    exit /b 0
)