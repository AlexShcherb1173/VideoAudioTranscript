:: ======================================================================
:: KINESCOPE2MP3.BAT
:: ======================================================================
::
:: Что делает данный BAT-файл:
::
:: Скрипт скачивает видео/аудиопоток по переданной ссылке
:: (Kinescope, YouTube, Vimeo и другие поддерживаемые сайты),
:: затем извлекает аудио и конвертирует его в MP3.
::
:: Используемые инструменты:
::
:: - yt-dlp   -> скачивание медиапотока
:: - ffmpeg   -> конвертация аудио в mp3
::
:: Основной сценарий работы:
::
:: 1. Устанавливает кодировку UTF-8 для корректного вывода русского текста
::
:: 2. Проверяет наличие папки ffmpeg
::
:: 3. Проверяет, передана ли ссылка в аргументах запуска
::
:: 4. Запрашивает имя будущего mp3-файла
::
:: 5. Создаёт папку data\mp3 если её нет
::
:: 6. Если файл с таким именем уже существует — удаляет его
::
:: 7. Через yt-dlp:
::    - скачивает поток
::    - извлекает аудио
::    - конвертирует в mp3
::
:: 8. Проверяет ошибки yt-dlp
::
:: 9. Проверяет, был ли реально создан mp3-файл
::
:: 10. Показывает итоговый путь сохранения
::
:: Пример запуска:
::
:: kinescope2mp3.bat https://kinescope.io/ID
::
:: Важные условия:
::
:: - yt-dlp.exe должен быть доступен в PATH или рядом со скриптом
:: - путь к ffmpeg задаётся вручную в FFMPEG_PATH
:: - имя файла вводится без расширения
::
:: ======================================================================

@echo off

:: ----------------------------------------------------------------------
:: Отключаем отображение команд в консоли
:: Консоль будет чище и покажет только нужные сообщения
:: ----------------------------------------------------------------------

chcp 65001 >nul

:: ----------------------------------------------------------------------
:: Устанавливаем UTF-8 кодировку консоли
:: Нужно для корректного отображения русского текста и символов
:: ----------------------------------------------------------------------

setlocal

:: ----------------------------------------------------------------------
:: Создаём локальную область переменных
:: После завершения BAT-файла переменные исчезнут
:: ----------------------------------------------------------------------


:: ======================================================================
:: ПУТЬ К FFMPEG
:: Здесь нужно указать папку, где лежат ffmpeg.exe / ffprobe.exe
:: ======================================================================

set "FFMPEG_PATH=D:\DEV\lib\ffmpeg-8.0-essentials_build\bin"

:: ----------------------------------------------------------------------
:: Проверяем существует ли указанная папка ffmpeg
:: Если нет — выводим ошибку и завершаем работу
:: ----------------------------------------------------------------------

if not exist "%FFMPEG_PATH%" (
    echo ❌ Ошибка: папка ffmpeg не найдена:
    echo     %FFMPEG_PATH%
    echo Проверь путь и исправь переменную FFMPEG_PATH в kinescope2mp3.bat
    pause
    exit /b
)

:: ----------------------------------------------------------------------
:: Проверяем передана ли ссылка как первый аргумент
::
:: %~1 = первый аргумент без кавычек
:: ----------------------------------------------------------------------

if "%~1"=="" (
    echo Использование: kinescope2mp3.bat [ссылка]
    echo Пример: kinescope2mp3.bat https://kinescope.io/ID
    pause
    exit /b
)

echo.

:: ----------------------------------------------------------------------
:: Красивый текстовый блок приглашения ввода имени файла
:: ----------------------------------------------------------------------

echo ╔════════════════════════════════════════╗
echo ║ Введите имя сохраняемого MP3-файла      ║
echo ╚════════════════════════════════════════╝

:: ----------------------------------------------------------------------
:: Запрашиваем имя файла у пользователя
:: Без расширения .mp3
:: ----------------------------------------------------------------------

set /p FILENAME=Введите имя файла (без расширения):

:: ----------------------------------------------------------------------
:: Если пользователь ничего не ввёл —
:: используем имя audio.mp3
:: ----------------------------------------------------------------------

if "%FILENAME%"=="" set "FILENAME=audio"

:: ----------------------------------------------------------------------
:: Создаём папку data\mp3 если её ещё нет
:: ----------------------------------------------------------------------

if not exist "data\mp3" mkdir "data\mp3"

:: ----------------------------------------------------------------------
:: Если файл с таким именем уже существует —
:: удаляем старую версию
:: ----------------------------------------------------------------------

if exist "data\mp3\%FILENAME%.mp3" del /q "data\mp3\%FILENAME%.mp3"

echo.
echo Скачиваю и конвертирую в MP3...

:: ----------------------------------------------------------------------
:: Основная команда yt-dlp
::
:: -x                    = извлечь только аудио
:: --audio-format mp3    = конвертация в mp3
:: --ffmpeg-location     = где лежит ffmpeg
:: -o                    = итоговый путь и имя файла
:: "%~1"                 = ссылка пользователя
:: ----------------------------------------------------------------------

yt-dlp -x --audio-format mp3 ^
    --ffmpeg-location "%FFMPEG_PATH%" ^
    -o "data/mp3/%FILENAME%.mp3" "%~1"

:: ----------------------------------------------------------------------
:: Проверяем код завершения yt-dlp
:: Если ошибка (errorlevel >=1), сообщаем пользователю
:: ----------------------------------------------------------------------

if errorlevel 1 (
    echo.
    echo ❌ Произошла ошибка при работе yt-dlp.
    echo Проверь вывод выше (возможно, проблема с ссылкой или форматом потока).
    pause
    exit /b
)

:: ----------------------------------------------------------------------
:: Даже если yt-dlp завершился без ошибки,
:: дополнительно проверяем создался ли файл реально
:: ----------------------------------------------------------------------

if not exist "data\mp3\%FILENAME%.mp3" (
    echo.
    echo ❌ MP3-файл не был создан. Скорее всего, поток без аудио или произошла ошибка постобработки.
    pause
    exit /b
)

:: ----------------------------------------------------------------------
:: Если всё прошло успешно — выводим сообщение
:: ----------------------------------------------------------------------

echo =========================================
echo ✅ Готово! Аудио сохранено: data\mp3\%FILENAME%.mp3
echo =========================================

pause